{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".env",
      ".env.example",
      ".gitignore",
      "server.mjs",
      "src/gemini-vision-server.mjs",
      "package.json",
      "package-lock.json",
      "README.md",
      "FIREBASE_DEPLOY_GUIDE.md",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "video_production/**",
      "**/.*",
      "**/node_modules/**",
      "agent_skills/coco-ssd/**",
      "agent_skills/frontend-design/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
